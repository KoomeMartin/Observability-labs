{
  "uid": "lab3-all-services-monitor",
  "title": "Lab 3 - All services anomaly monitor",
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "lab3",
    "anomaly"
  ],
  "panels": [
    {
      "id": 1,
      "type": "state-timeline",
      "title": "All services - anomaly flags",
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "ok"
                },
                "1": {
                  "text": "anomaly"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "PBFA97CFB590B2093"
          },
          "expr": "max by (service) (lab3_anomalies_and_incidents{kind=\"anomaly\"})",
          "legendFormat": "{{service}}",
          "refId": "A",
          "range": true
        }
      ]
    },
